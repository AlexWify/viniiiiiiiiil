@model IEnumerable<VinylStore.Record>

<h2>Каталог пластинок</h2>
<p><a asp-action="Create" class="btn btn-primary">Добавить пластинку</a></p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Title)</th>
            <th>@Html.DisplayNameFor(m => m.Artist)</th>
            <th>@Html.DisplayNameFor(m => m.Genre)</th>
            <th>@Html.DisplayNameFor(m => m.Year)</th>
            <th>@Html.DisplayNameFor(m => m.Price)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Title</td>
            <td>@item.Artist</td>
            <td>@item.Genre?.Name</td>
            <td>@item.Year</td>
            <td>@item.Price ₽</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Изменить</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
            </td>
        </tr>
}
    </tbody>
</table>