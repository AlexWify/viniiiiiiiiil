@model IEnumerable<VinylStore.Genre>

<h2>Список жанров</h2>
<p><a asp-action="Create" class="btn btn-primary">Добавить жанр</a></p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
        </tr>
}
    </tbody>
</table>